  function ensureParentActive(parentKey) {
    var parentBtn = document.querySelector('.sb-btn[data-type="parent"][data-key="' + parentKey + '"]');
    if (!parentBtn) return;
    if (!state.open[parentKey]) setParentOpen(parentKey, true, parentBtn);
