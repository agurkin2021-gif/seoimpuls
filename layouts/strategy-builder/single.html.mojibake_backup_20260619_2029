    var topTarget = startY + rect.top - headerOffset - 12;
    var extraBottomPad = Number(opts.extraBottomPad) || 0;
    var bottomTarget = startY + rect.bottom - window.innerHeight + 22 + extraBottomPad;
    var targetY = opts.preferBottom
      ? Math.max(topTarget, bottomTarget)
      : topTarget;
    return Math.max(0, targetY);
  }

  function scrollToResponseSmooth(opts) {
    if (!response) return;
    opts = opts || {};
    var targetY = getResponseTargetY(opts);
    var currentY = window.pageYOffset || document.documentElement.scrollTop || 0;
    if (Math.abs(targetY - currentY) < 1) return;

    if (scrollAnimRaf) {
      window.cancelAnimationFrame(scrollAnimRaf);
      scrollAnimRaf = 0;
    }

    // Tiny instant nudge removes perceived click pause; then browser performs smooth deceleration.
    window.scrollTo(0, currentY + (targetY > currentY ? 10 : -10));
    window.scrollTo({ top: targetY, behavior: "smooth" });
  }

  applyBtn.addEventListener("click", function () {
    if (isApplied) {
      response.classList.add("is-collapsed");
      response.style.removeProperty("min-height");
      setApplyState(false);
      return;
    }

    if (!hasRequiredBaseSelection()) {
      showPrereqNotice();
      setApplyState(false);
      return;
    }

    var list = tokens();
    if (!list.length) {
      response.classList.remove("is-collapsed");
      response.style.removeProperty("min-height");
      response.textContent = T.selectOne;
      setApplyState(false);
      return;
    }

    response.classList.remove("is-collapsed");
    setApplyState(true);
    response.style.minHeight = "420px";
    response.textContent = lang === "ru"
      ? "Р¤РѕСЂРјРёСЂСѓРµРј РїСЂРѕРіРЅРѕР·..."
      : (lang === "es" ? "Generando pronГіstico..." : "Building forecast...");
    scrollToResponseSmooth({ preferBottom: true, extraBottomPad: 220 });

    window.setTimeout(function () {
      var model = estimateModel();
      response.innerHTML = buildTemporaryResponse(list, model);
      pruneLegacyResponseSignature();
      response.style.removeProperty("min-height");
    }, 0);
  });

  setApplyState(false);
  renderChips();
  updateBaseDividerState();
  applyButtonTooltips();
  window.addEventListener("resize", function () {
    if (!isApplied) return;
    syncAppliedSideHeight();
  });
})();
</script>
