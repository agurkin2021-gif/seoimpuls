      var itemValue = Number(item.getAttribute("data-value"));
      var isNumericActive = !qtyPickerState.tempSpecial && value > 0 && itemValue === value;
      item.classList.toggle("is-active", isNumericActive);
    });
  }

  function scrollWheelToValue(value) {
    if (!qtyWheel) return;
    var target = qtyWheel.querySelector('.sb-qty-item[data-value="' + value + '"]');
    if (!target) return;
    target.scrollIntoView({ block: "center", inline: "nearest" });
  }

  function closestWheelValue() {
    if (!qtyWheel) return qtyPickerState.tempValue;
    var items = qtyWheel.querySelectorAll('.sb-qty-item[data-value]');
    if (!items.length) return qtyPickerState.tempValue;
    var wheelRect = qtyWheel.getBoundingClientRect();
    var centerY = wheelRect.top + wheelRect.height / 2;
    var nearest = items[0];
    var minDist = Infinity;

    items.forEach(function (item) {
      var rect = item.getBoundingClientRect();
      var itemCenter = rect.top + rect.height / 2;
      var dist = Math.abs(itemCenter - centerY);
      if (dist < minDist) {
        minDist = dist;
        nearest = item;
      }
    });

    return Number(nearest.getAttribute("data-value"));
  }

  function placeQtyPicker(anchorBtn) {
    if (!qtyPop || !anchorBtn) return;
    var rect = anchorBtn.getBoundingClientRect();
    var popRect = qtyPop.getBoundingClientRect();
    var width = popRect.width || 260;
    var height = popRect.height || 280;
    var gap = 8;

    var left = rect.left + rect.width / 2 - width / 2;
    var top = rect.bottom + gap;

    if (left < 8) left = 8;
    if (left + width > window.innerWidth - 8) left = window.innerWidth - width - 8;
    if (top + height > window.innerHeight - 8) top = Math.max(8, rect.top - height - gap);

    qtyPop.style.left = left + "px";
    qtyPop.style.top = top + "px";
  }

  function closeQtyPicker() {
    if (!qtyPicker) return;
    qtyPicker.classList.remove("is-open");
    qtyPicker.setAttribute("aria-hidden", "true");
    qtyPickerState.key = "";
    qtyPickerState.label = "";
    qtyPickerState.btn = null;
  }

  function openQtyPicker(key, label, btn) {
    if (!qtyPicker || !qtyWheel || !qtyTitle) return;
    var isAlreadyActive = btn && btn.classList.contains("is-active");
    var selected = isAlreadyActive ? quantityValue(key) : 0;
    qtyPickerState.key = key;
    qtyPickerState.label = label;
    qtyPickerState.btn = btn;
    qtyPickerState.tempValue = selected;
    qtyPickerState.tempSpecial = isAlreadyActive && key === "pbn" && !!state.qtyMeta.pbnFootprints;

    qtyTitle.textContent = quantityPromptForKey(key);
    buildQuantityWheel(key, selected, qtyPickerState.tempSpecial);
    setActiveWheelSelection(selected, qtyPickerState.tempSpecial);
    qtyPicker.classList.add("is-open");
    qtyPicker.setAttribute("aria-hidden", "false");

    requestAnimationFrame(function () {
      placeQtyPicker(btn);
      if (selected > 0) scrollWheelToValue(selected);
    });
  }

  function labelWithQuantity(baseLabel, key) {
    if (!isQuantityKey(key)) return baseLabel;
    if (key === "pbn" && state.qtyMeta.pbnFootprints) return T.qtyFootprintsChip;
    return baseLabel + " x" + quantityValue(key);
  }

  function formatBonusValue(value) {
    if (!Number.isFinite(value)) return "0";
    if (Math.abs(value - Math.round(value)) < 0.05) return String(Math.round(value));
    return value.toFixed(1);
  }

  function pbnBonusByCount(count) {
    if (count <= 0) return 0;
    var firstBonus = 5;
    if (state.singleKey.freq === "mid") firstBonus = 3;
    if (state.singleKey.freq === "high") firstBonus = 1;
    return count * firstBonus;
  }

  function pbnPositionBoostByCount(count) {
    if (count <= 0) return 0;
    var firstBoost = 5;
    if (state.singleKey.freq === "mid") firstBoost = 3;
    if (state.singleKey.freq === "high") firstBoost = 1;
    return count * firstBoost;
  }

  function pbnToolBonusCurrent() {
    if (!isPbnEffective()) return 0;
    return pbnBonusByCount(quantityValue("pbn"));
  }

  function hasPbnQuantityActive() {
    return isPbnEffective() && quantityValue("pbn") > 0;
  }

  function crowdBonusByCount(count) {
    if (count <= 5) return count * 1.2;
    if (count <= 10) return 6 + (count - 5) * 0.8;
    return 10 + (count - 10) * 0.5;
  }

  function crowdPositionBoostByCount(count) {
    if (count <= 0) return 0;
    if (count <= 5) return count * 0.8;
    if (count <= 10) return 4 + (count - 5) * 0.45;
    return 6.25 + (count - 10) * 0.25;
  }

  function redirectBonusByCount(count) {
    if (count <= 0) return 0;
    var perRedirect = 4;
    if (state.singleKey.freq === "mid") perRedirect = 6;
    if (state.singleKey.freq === "high") perRedirect = 4;
    return count * perRedirect * redirectContextMultiplier();
  }

  function redirectPositionBoostByCount(count) {
    if (count <= 0) return 0;
    var perRedirect = 3;
    if (state.singleKey.freq === "mid") perRedirect = 4.5;
    if (state.singleKey.freq === "high") perRedirect = 3;
    return count * perRedirect * redirectContextMultiplier();
  }

  function redirectContextMultiplier() {
    var m = 1;
    if (isMultiKeyActive("onepage")) m += 0.25;
    if (isMultiKeyActive("newregs")) m += 0.20;
    if (isMultiKeyActive("multipage")) m -= 0.45;
    if (isMultiKeyActive("drops")) m -= 0.35;
    return clamp(m, 0.25, 1.6);
  }

  function xrProfilesBonus() {
    if (state.singleKey.freq === "high") return 0;
    if (state.singleKey.freq === "mid") return 0.5;
    return 0.8;
  }

  function xrProfilesPositionBoost() {
    if (state.singleKey.freq === "high") return 0;
    if (state.singleKey.freq === "mid") return 0.35;
    return 0.6;
  }

  function gsaArticlesBonus() {
    if (state.singleKey.freq === "high") return 0.3;
    if (state.singleKey.freq === "mid") return 0.4;
    return 0.5;
  }

  function gsaArticlesPositionBoost() {
    if (state.singleKey.freq === "high") return 0.12;
    if (state.singleKey.freq === "mid") return 0.18;
    return 0.22;
  }

  function gsaWeb20Bonus() {
    return 0.2;
  }

  function gsaWeb20PositionBoost() {
    return 0.18;
  }

  function gsaTier123Bonus() {
    return 6.0;
  }

  function gsaTier123PositionBoost() {
    return 2.9;
  }

  function socialSignalsBonus() {
    return 4.2;
  }

  function socialSignalsPositionBoost() {
    return 1.4;
  }

  function behaviorBonus() {
    if (state.singleKey.freq === "high") return 2.0;
    if (state.singleKey.freq === "mid") return 1.2;
    return 1.0;
  }

  function behaviorPositionBoost() {
    if (state.singleKey.freq === "high") return 0.8;
    if (state.singleKey.freq === "mid") return 0.55;
    return 0.45;
  }

  function toolBonusPoints() {
    var bonus = 0;
    if (isSubKeyActive("xrumer", "xr_forums")) bonus += 3;
    if (isSubKeyActive("xrumer", "xr_comments")) bonus += 3;
    if (isSubKeyActive("xrumer", "xr_profiles")) bonus += xrProfilesBonus();
    if (isSubKeyActive("gsa", "gsa_articles")) bonus += gsaArticlesBonus();
    if (isSubKeyActive("gsa", "gsa_web20")) bonus += gsaWeb20Bonus();
    if (isSubKeyActive("gsa", "gsa_t123")) bonus += gsaTier123Bonus();
    if (hasPbnQuantityActive()) bonus += pbnBonusByCount(quantityValue("pbn"));
    if (isMultiKeyActive("crowd")) bonus += crowdBonusByCount(quantityValue("crowd"));
    if (isMultiKeyActive("r301")) bonus += redirectBonusByCount(quantityValue("r301"));
    if (isMultiKeyActive("behavior")) bonus += behaviorBonus();
    if (isMultiKeyActive("social")) bonus += socialSignalsBonus();
    if (isMultiKeyActive("branding")) bonus += 3;
    if (isMultiKeyActive("parasite_seo")) bonus += 0.3;
    return Math.round(bonus * 10) / 10;
  }

  function hasAnyXrumerSubActive() {
    return isSubKeyActive("xrumer", "xr_forums") || isSubKeyActive("xrumer", "xr_comments") || isSubKeyActive("xrumer", "xr_profiles");
  }

  function hasAnyGsaSubActive() {
    return isSubKeyActive("gsa", "gsa_articles") || isSubKeyActive("gsa", "gsa_web20") || isSubKeyActive("gsa", "gsa_t123");
  }

  function hasAnyPromotionToolActive() {
    return (
      hasAnyXrumerSubActive() ||
      hasAnyGsaSubActive() ||
      hasPbnQuantityActive() ||
      isMultiKeyActive("crowd") ||
      isMultiKeyActive("r301") ||
      isMultiKeyActive("behavior") ||
      isMultiKeyActive("social") ||
      isMultiKeyActive("branding") ||
      isMultiKeyActive("parasite_seo")
    );
  }

  function hasAnyPromotionToolExceptPbn() {
    return (
      hasAnyXrumerSubActive() ||
      hasAnyGsaSubActive() ||
      isMultiKeyActive("crowd") ||
      isMultiKeyActive("r301") ||
      isMultiKeyActive("behavior") ||
      isMultiKeyActive("social") ||
      isMultiKeyActive("branding") ||
      isMultiKeyActive("parasite_seo")
    );
  }

  function adjustedToolBonus(rawBonus) {
    var freqScale = 0.22;
    if (state.singleKey.freq === "low") freqScale = 0.30;
    if (state.singleKey.freq === "mid") freqScale = 0.24;
    if (state.singleKey.freq === "high") freqScale = 0.20;

    var adjusted = rawBonus * freqScale;

    if (isMultiKeyActive("onepage")) {
      if (state.singleKey.freq === "high") adjusted -= 2.0;
      else if (state.singleKey.freq === "mid") adjusted -= 0.5;
      else adjusted += 0.5;
    }
    if (isMultiKeyActive("multipage")) {
      if (state.singleKey.freq === "high") adjusted += 2.0;
      else if (state.singleKey.freq === "mid") adjusted += 0.8;
    }

    if (isMultiKeyActive("dynamic")) adjusted += 0.8;
    if (isMultiKeyActive("static")) adjusted += 0.2;
    if (isMultiKeyActive("drops")) adjusted += 1.2;
    if (isMultiKeyActive("newregs")) adjusted -= 0.3;

    if (isMultiKeyActive("r301")) {
      var redirectBoost = 0;
      var redirectCount = quantityValue("r301");
      if (state.singleKey.freq === "low") redirectBoost = 5.0 * redirectCount;
      else if (state.singleKey.freq === "mid") redirectBoost = 5.5 * redirectCount;
      else redirectBoost = 3.6 * redirectCount;

      redirectBoost *= redirectContextMultiplier();
      if (hasAnyXrumerSubActive() || hasAnyGsaSubActive()) redirectBoost += 1.5;
      if (isMultiKeyActive("onepage") && isMultiKeyActive("newregs")) redirectBoost += 0.8;
      if (isMultiKeyActive("multipage") || isMultiKeyActive("drops")) redirectBoost -= 0.8;
      if (redirectBoost < 0) redirectBoost = 0;

      adjusted += redirectBoost;
    }

    if (isMultiKeyActive("behavior")) adjusted -= 0.6;

    return clamp(Math.round(adjusted), 0, 24);
  }

  function baseScenarioPositionFromHeader() {
    var delta = 0;
    var risk = 0;
    var trust = 0;

    var basePos = 44;
    if (state.singleKey.freq === "low") basePos = 30;
    if (state.singleKey.freq === "mid") basePos = 42;
    if (state.singleKey.freq === "high") basePos = 56;

    if (state.singleKey.theme === "white") { delta -= 1; trust += 1; }
    if (state.singleKey.theme === "gray") { delta += 1; risk += 2; }

    if (isMultiKeyActive("drops")) { delta -= 2; risk += 2; }
    if (isMultiKeyActive("newregs")) { delta += 1; }

    if (isMultiKeyActive("onepage")) {
      if (state.singleKey.freq === "high") delta += 4;
      else if (state.singleKey.freq === "mid") delta += 1;
      else delta -= 1;
    }
    if (isMultiKeyActive("multipage")) {
      if (state.singleKey.freq === "high") delta -= 2;
      else if (state.singleKey.freq === "mid") delta -= 1;
    }
    if (isMultiKeyActive("static")) {
      if (state.singleKey.freq === "high") delta += 1;
      else if (state.singleKey.freq === "low") delta -= 1;
    }
    if (isMultiKeyActive("dynamic")) {
      if (state.singleKey.freq === "high") delta -= 2;
      else if (state.singleKey.freq === "mid") delta -= 1;
    }

    var hasHeaderAuthority = isMultiKeyActive("drops");
    if (!hasHeaderAuthority && state.singleKey.freq === "high") {
      delta += 4;
      risk += 1;
    }

    var raw = basePos + delta + Math.round(risk * 0.6) - Math.round(Math.max(0, trust) * 0.35);

    var floor = 6;
    if (state.singleKey.freq === "mid") floor = 14;
    if (state.singleKey.freq === "high") floor = 22;
    if (state.singleKey.theme === "gray") floor += 1;
    if (risk >= 8) floor += 3;
    floor = Math.max(6, floor);

    return clamp(Math.round(raw), floor, 90);
  }

  function estimateModel() {
    var hasPromoTools = hasAnyPromotionToolActive();
    var delta = 0;
    var risk = 0;
    var trust = 0;
    var activeCount = 0;

    function applyFactor(active, posDelta, riskDelta, trustDelta) {
      if (!active) return;
      activeCount += 1;
      delta += posDelta;
      risk += riskDelta || 0;
      trust += trustDelta || 0;
    }

    var basePos = 44;
    if (state.singleKey.freq === "low") basePos = 30;
    if (state.singleKey.freq === "mid") basePos = 42;
    if (state.singleKey.freq === "high") basePos = 56;

    if (state.singleKey.theme === "white") { delta -= 1; trust += 1; }
    if (state.singleKey.theme === "gray") { delta += 1; risk += 2; }

    if (isPbnEffective()) {
      activeCount += 1;
      delta -= pbnPositionBoostByCount(quantityValue("pbn"));
    }
    if (isMultiKeyActive("crowd")) {
      activeCount += 1;
      delta -= crowdPositionBoostByCount(quantityValue("crowd"));
      trust += 2;
    }
    if (isMultiKeyActive("r301")) {
      activeCount += 1;
      delta -= redirectPositionBoostByCount(quantityValue("r301"));
      trust += 1;
    }
    applyFactor(isMultiKeyActive("drops"), -2, 2, 0);
    applyFactor(isMultiKeyActive("newregs"), 1, 0, 0);
    applyFactor(isMultiKeyActive("behavior"), -behaviorPositionBoost(), 0, 0.45);
    applyFactor(isMultiKeyActive("social"), -socialSignalsPositionBoost(), 0, 1.2);
    applyFactor(isMultiKeyActive("branding"), -2, 0, 2);
    applyFactor(isMultiKeyActive("parasite_seo"), -0.7, 0.7, -0.35);

    applyFactor(isSubKeyActive("xrumer", "xr_forums"), -1, 0, 1);
    applyFactor(isSubKeyActive("xrumer", "xr_comments"), -1, 0, 0);
    applyFactor(isSubKeyActive("xrumer", "xr_profiles"), -xrProfilesPositionBoost(), 0.2, 0);
    applyFactor(isSubKeyActive("gsa", "gsa_articles"), -gsaArticlesPositionBoost(), 0.2, 0);
    applyFactor(isSubKeyActive("gsa", "gsa_web20"), -gsaWeb20PositionBoost(), 0.2, 0);
    applyFactor(isSubKeyActive("gsa", "gsa_t123"), -gsaTier123PositionBoost(), 1.2, -0.4);

    if (isMultiKeyActive("onepage")) {
      if (state.singleKey.freq === "high") delta += 4;
      else if (state.singleKey.freq === "mid") delta += 1;
      else delta -= 1;
    }
    if (isMultiKeyActive("multipage")) {
      if (state.singleKey.freq === "high") delta -= 2;
      else if (state.singleKey.freq === "mid") delta -= 1;
    }
    if (isMultiKeyActive("static")) {
      if (state.singleKey.freq === "high") delta += 1;
      else if (state.singleKey.freq === "low") delta -= 1;
    }
    if (isMultiKeyActive("dynamic")) {
      if (state.singleKey.freq === "high") delta -= 2;
      else if (state.singleKey.freq === "mid") delta -= 1;
    }

    var authorityPack = isPbnEffective() || isMultiKeyActive("drops") || isMultiKeyActive("r301");
    var foundationPack = isMultiKeyActive("crowd") || isMultiKeyActive("behavior") || isMultiKeyActive("social") || isMultiKeyActive("branding");
    var aggressivePack = state.singleKey.theme === "gray" || isSubKeyActive("gsa", "gsa_t123") || isMultiKeyActive("parasite_seo");

    if (authorityPack && foundationPack) {
      delta -= 4;
      trust += 1;
    }
    if (authorityPack && !foundationPack && !isPbnEffective() && !isMultiKeyActive("r301")) {
      delta += 2;
      risk += 1;
    }
    if (!authorityPack && state.singleKey.freq === "high") {
      delta += 4;
      risk += 1;
    }
    if (isMultiKeyActive("newregs") && (isMultiKeyActive("drops") || isMultiKeyActive("parasite_seo"))) {
      delta += 1;
      risk += 1;
    }
    if (isMultiKeyActive("parasite_seo") && (foundationPack || authorityPack)) {
      delta -= 0.7;
      trust += 0.35;
    }
    if (isMultiKeyActive("parasite_seo") && !foundationPack && !authorityPack) {
      delta += 0.7;
      risk += 0.35;
    }
    if (isMultiKeyActive("parasite_seo") && !isMultiKeyActive("branding")) {
      risk += 0.35;
    }
    if (state.singleKey.theme === "gray" && authorityPack) {
      delta -= 1;
      risk += 1;
    }
    if (state.singleKey.freq === "high" && authorityPack && foundationPack) {
      delta -= 5;
    }
    if (
      state.singleKey.freq === "high" &&
      isMultiKeyActive("behavior") &&
      isMultiKeyActive("branding") &&
      isMultiKeyActive("crowd")
    ) {
      delta -= 4;
    }
    if (trust < 0) {
      delta += 1;
    }

    var baseScenarioPosition = baseScenarioPositionFromHeader();

    if (!hasPromoTools) {
      return {
        position: baseScenarioPosition,
        risk: 0,
        trust: 0,
        indicatorBonus: 0,
        effectiveBonus: 0,
        activeCount: 0,
        aggressivePack: false,
        authorityPack: false,
        foundationPack: false
      };
    }

    if (isPbnEffective() && !hasAnyPromotionToolExceptPbn()) {
      var pbnOnlyBoost = pbnPositionBoostByCount(quantityValue("pbn"));
      var pbnOnlyPosition = clamp(Math.round(baseScenarioPosition - pbnOnlyBoost), 6, 90);
      var pbnOnlyBonus = toolBonusPoints();
      return {
        position: pbnOnlyPosition,
        risk: 1,
        trust: 0,
        indicatorBonus: pbnOnlyBonus,
        effectiveBonus: 0,
        activeCount: 1,
        aggressivePack: false,
        authorityPack: true,
        foundationPack: false
      };
    }

    var indicatorBonus = toolBonusPoints();
    var nonPbnBonus = Math.max(0, indicatorBonus - pbnToolBonusCurrent());
    var effectiveBonus = adjustedToolBonus(nonPbnBonus);
    delta -= effectiveBonus;

    var positionRaw = basePos + delta + Math.round(risk * 0.35) - Math.round(Math.max(0, trust) * 0.45);

    var floor = 6;
    if (state.singleKey.freq === "mid") floor = 10;
    if (state.singleKey.freq === "high") floor = 10;
    if (aggressivePack) floor += 1;
    if (risk >= 8) floor += 2;
    if (state.singleKey.freq === "high" && authorityPack && foundationPack && trust >= 3 && risk <= 8) floor -= 6;
    if (isPbnEffective()) floor -= Math.min(8, Math.floor(quantityValue("pbn") / 2));
    if (isMultiKeyActive("r301")) floor -= (2 * quantityValue("r301"));
    if (indicatorBonus >= 20) floor -= 3;
    if (indicatorBonus >= 35) floor -= 4;
    floor = Math.max(6, floor);

    var position = clamp(Math.round(positionRaw), floor, 90);
    if (hasPromoTools) position = Math.min(position, baseScenarioPosition);

    return {
      position: position,
      risk: risk,
      trust: trust,
      indicatorBonus: indicatorBonus,
      effectiveBonus: effectiveBonus,
      activeCount: activeCount,
      aggressivePack: aggressivePack,
      authorityPack: authorityPack,
      foundationPack: foundationPack
    };
  }

  function estimatePosition() {
    return estimateModel().position;
  }

  function estimateUncertainty(model) {
    var spread = 4 + Math.round(model.risk * 0.9);
    if (state.singleKey.freq === "high") spread += 2;
    if (model.aggressivePack) spread += 2;
    if (model.foundationPack && model.authorityPack) spread -= 1;
    if (model.trust >= 4) spread -= 1;
    return clamp(spread, 4, 18);
  }

  function estimateRange(model) {
    var spread = estimateUncertainty(model);
    return {
      low: clamp(model.position - spread, 1, 99),
      high: clamp(model.position + spread, 1, 99),
      spread: spread
    };
  }

  function volatilityText(spread) {
    if (spread >= 13) return T.volatilityHigh;
    if (spread >= 8) return T.volatilityMid;
    return T.volatilityLow;
  }

  function updateRankIndicator() {
    var model = estimateModel();
    var band = visibilityBand(model.position);

    if (rankCircle) rankCircle.style.setProperty("--pos-color", band.color);
    if (rankValue) rankValue.textContent = model.position > 50 ? "50+" : "#" + model.position;
    if (rankBand) rankBand.textContent = band.text;
    if (rankBonus) rankBonus.textContent = model.indicatorBonus > 0 ? (T.bonusLabel + " +" + formatBonusValue(model.indicatorBonus)) : "";
  }

  function renderChips() {
    normalizePbnFootprintsState();
    var baseList = [];
    var toolList = [];

    if (state.single.freq) baseList.push(state.single.freq);
    if (state.single.theme) baseList.push(state.single.theme);

    var baseDomainBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="newregs"].is-active, .sb-btn[data-type="multi"][data-key="drops"].is-active');
    var baseSiteBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="static"].is-active, .sb-btn[data-type="multi"][data-key="dynamic"].is-active');
    var baseStructureBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="onepage"].is-active, .sb-btn[data-type="multi"][data-key="multipage"].is-active');
    if (baseDomainBtn) baseList.push(baseDomainBtn.textContent.trim());
    if (baseSiteBtn) baseList.push(baseSiteBtn.textContent.trim());
    if (baseStructureBtn) baseList.push(baseStructureBtn.textContent.trim());

    ["pbn", "crowd", "r301", "behavior", "social", "branding", "parasite_seo"].forEach(function (key) {
      var btn = document.querySelector('.sb-btn[data-type="multi"][data-key="' + key + '"]');
      if (btn && btn.classList.contains("is-active")) {
        toolList.push({
          text: labelWithQuantity(btn.textContent.trim(), key),
          danger: key === "pbn" && state.qtyMeta.pbnFootprints
        });
      }
    });
    ["xr_forums", "xr_comments", "xr_profiles", "gsa_articles", "gsa_web20", "gsa_t123"].forEach(function (key) {
      var btn = document.querySelector('.sb-btn[data-type="sub"][data-key="' + key + '"]');
      if (btn && btn.classList.contains("is-active")) toolList.push({ text: btn.textContent.trim(), danger: false });
    });

    var html = "";
    if (baseList.length) {
      html += '<div class="sb-chip-base-col">' + baseList.map(function (w) { return '<span class="sb-chip">' + w + '</span>'; }).join("") + '</div>';
    }
    if (toolList.length) {
      html += '<div class="sb-chip-tools-row">' + toolList.map(function (item) {
        var chipClass = item.danger ? "sb-chip sb-chip-danger" : "sb-chip";
        return '<span class="' + chipClass + '">' + item.text + '</span>';
      }).join("") + '</div>';
    }

    chipsHost.innerHTML = html;
    chipsHost.classList.toggle("is-base-complete", hasRequiredBaseSelection());
    placeholder.style.display = (baseList.length || toolList.length) ? "none" : "block";
    if (isApplied) syncAppliedSideHeight();
    updateRankIndicator();
    applyButtonTooltips();
  }

  function flyWord(word, fromEl) {
    if (!word || !fromEl || !dropzone) return;

    var from = fromEl.getBoundingClientRect();
    var to = dropzone.getBoundingClientRect();

    var startX = from.left + from.width / 2;
    var startY = from.top + from.height / 2;
    var endX = to.left + to.width / 2;
    var endY = to.top + 42;

    var el = document.createElement("div");
    el.className = "sb-fly";
    el.textContent = word;
    el.style.left = startX + "px";
    el.style.top = startY + "px";
    el.style.setProperty("--dx", (endX - startX) + "px");
    el.style.setProperty("--dy", (endY - startY) + "px");
    document.body.appendChild(el);

    requestAnimationFrame(function () {
      el.classList.add("is-flying");
    });

    setTimeout(function () {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 700);
  }

  function setSingle(group, key, label, btn) {
    document.querySelectorAll('.sb-btn[data-type="single"][data-group="' + group + '"]').forEach(function (n) {
      n.classList.remove("is-active");
    });
    btn.classList.add("is-active");
    state.single[group] = label;
    state.singleKey[group] = key;
    flyWord(label, btn);
    invalidateAppliedResponse();
    renderChips();
  }

  function toggleMulti(key, label, btn) {
    var on = btn.classList.toggle("is-active");
    if (on) {
      if (key === "drops") {
        var newregsBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="newregs"]');
        if (newregsBtn && newregsBtn.classList.contains("is-active")) {
          newregsBtn.classList.remove("is-active");
          removeToken(newregsBtn.textContent.trim());
        }
      }
      if (key === "newregs") {
        var dropsBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="drops"]');
        if (dropsBtn && dropsBtn.classList.contains("is-active")) {
          dropsBtn.classList.remove("is-active");
          removeToken(dropsBtn.textContent.trim());
        }
      }
      if (key === "static") {
        var dynamicBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="dynamic"]');
        if (dynamicBtn && dynamicBtn.classList.contains("is-active")) {
          dynamicBtn.classList.remove("is-active");
          removeToken(dynamicBtn.textContent.trim());
        }
      }
      if (key === "dynamic") {
        var staticBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="static"]');
        if (staticBtn && staticBtn.classList.contains("is-active")) {
          staticBtn.classList.remove("is-active");
          removeToken(staticBtn.textContent.trim());
        }
      }
      if (key === "onepage") {
        var multipageBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="multipage"]');
        if (multipageBtn && multipageBtn.classList.contains("is-active")) {
          multipageBtn.classList.remove("is-active");
          removeToken(multipageBtn.textContent.trim());
        }
      }
      if (key === "multipage") {
        var onepageBtn = document.querySelector('.sb-btn[data-type="multi"][data-key="onepage"]');
        if (onepageBtn && onepageBtn.classList.contains("is-active")) {
          onepageBtn.classList.remove("is-active");
          removeToken(onepageBtn.textContent.trim());
        }
      }
      addToken(label);
      flyWord(label, btn);
    } else {
      removeToken(label);
    }
    if (key === "pbn") {
      btn.classList.toggle("is-footprints", on && state.qtyMeta.pbnFootprints);
      if (!on) {
        state.qtyMeta.pbnFootprints = false;
        state.qty.pbn = 1;
