  function setParentOpen(parentKey, open, parentBtn) {
    state.open[parentKey] = open;
    parentBtn.classList.toggle("is-open", open);
    parentBtn.classList.toggle("is-active", open);

    var menu = document.querySelector('.sb-submenu[data-parent="' + parentKey + '"]');
    if (menu) menu.classList.toggle("is-open", open);

    var changed = false;
    if (!open) {
      document.querySelectorAll('.sb-btn[data-type="sub"][data-parent="' + parentKey + '"]').forEach(function (subBtn) {
        if (subBtn.classList.contains("is-active")) {
          subBtn.classList.remove("is-active");
          removeToken(subBtn.textContent.trim());
          changed = true;
        }
      });
    }
    if (changed) invalidateAppliedResponse();
    renderChips();
