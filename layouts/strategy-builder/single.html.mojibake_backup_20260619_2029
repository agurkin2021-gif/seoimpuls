  function hidePrereqNotice() {
    if (!prereqNotice) return;
    prereqNotice.classList.remove("is-visible");
    prereqNotice.textContent = "";
  }

  function prereqItems() {
    return [
      { num: 1, label: T.reqPages, done: (isMultiKeyActive("onepage") || isMultiKeyActive("multipage")) },
      { num: 2, label: T.reqFreq, done: !!state.singleKey.freq },
      { num: 3, label: T.reqTheme, done: !!state.singleKey.theme },
      { num: 4, label: T.reqDomain, done: (isMultiKeyActive("newregs") || isMultiKeyActive("drops")) },
      { num: 5, label: T.reqSite, done: (isMultiKeyActive("static") || isMultiKeyActive("dynamic")) }
    ];
  }

  function buildPrereqNoticeHtml() {
    var items = prereqItems();
    var allDone = items.every(function (item) { return item.done; });
    if (allDone) return "";

    var listHtml = items.map(function (item) {
      var itemClass = item.done ? "sb-prereq-item is-done" : "sb-prereq-item is-missing";
      return '<div class="' + itemClass + '"><span class="sb-prereq-dot" aria-hidden="true"></span><span>' + item.num + '. ' + escapeHtml(item.label) + '</span></div>';
    }).join("");

    return (
      '<p class="sb-prereq-title">' + escapeHtml(T.prereqIntro) + '</p>' +
      '<div class="sb-prereq-list">' + listHtml + '</div>' +
      '<p class="sb-prereq-outro">' + escapeHtml(T.prereqOutro) + '</p>'
    );
  }

  function showPrereqNotice() {
    if (!prereqNotice) return;
    var html = buildPrereqNoticeHtml();
    if (!html) {
      hidePrereqNotice();
      return;
    }
    prereqNotice.innerHTML = html;
    prereqNotice.classList.add("is-visible");
  }

  document.addEventListener("click", function (event) {
    if (!prereqNotice || !prereqNotice.classList.contains("is-visible")) return;
    if (toolsScope && toolsScope.contains(event.target)) return;
    hidePrereqNotice();
  });

  function hasRequiredBaseSelection() {
    var hasFreq = !!state.singleKey.freq;
    var hasTheme = !!state.singleKey.theme;
    var hasDomainType = isMultiKeyActive("newregs") || isMultiKeyActive("drops");
    var hasSiteType = isMultiKeyActive("static") || isMultiKeyActive("dynamic");
    var hasPagesFormat = isMultiKeyActive("onepage") || isMultiKeyActive("multipage");
    return hasFreq && hasTheme && hasDomainType && hasSiteType && hasPagesFormat;
  }

  function updateBaseDividerState() {
    if (!baseRows) return;
    baseRows.classList.toggle("is-complete", hasRequiredBaseSelection());
  }

  function refreshPrereqNoticeIfVisible() {
    if (!prereqNotice || !prereqNotice.classList.contains("is-visible")) return;
    var html = buildPrereqNoticeHtml();
    if (!html) {
      hidePrereqNotice();
      return;
    }
    prereqNotice.innerHTML = html;
  }

  function isBaseRequirementKey(key) {
    return key === "newregs" || key === "drops" || key === "static" || key === "dynamic" || key === "onepage" || key === "multipage";
  }

  function resetPromotionToolsIfBaseInvalid() {
    if (hasRequiredBaseSelection()) return;

    var changed = false;

    document.querySelectorAll('.sb-btn[data-type="sub"]').forEach(function (subBtn) {
      if (!subBtn.classList.contains("is-active")) return;
      subBtn.classList.remove("is-active");
      removeToken(subBtn.textContent.trim());
      changed = true;
    });

    document.querySelectorAll('.sb-btn[data-type="multi"]').forEach(function (multiBtn) {
      var mKey = multiBtn.getAttribute("data-key");
      if (isBaseRequirementKey(mKey)) return;
      if (!multiBtn.classList.contains("is-active")) return;
      multiBtn.classList.remove("is-active");
      if (mKey === "pbn") {
        multiBtn.classList.remove("is-footprints");
        state.qtyMeta.pbnFootprints = false;
        state.qty.pbn = 1;
      }
      removeToken(multiBtn.textContent.trim());
      changed = true;
    });

    document.querySelectorAll('.sb-btn[data-type="parent"]').forEach(function (parentBtn) {
      var pKey = parentBtn.getAttribute("data-key");
      if (state.open[pKey]) changed = true;
      state.open[pKey] = false;
      parentBtn.classList.remove("is-open");
      parentBtn.classList.remove("is-active");
    });

    document.querySelectorAll('.sb-submenu').forEach(function (menu) {
      menu.classList.remove("is-open");
    });

    if (changed) {
      invalidateAppliedResponse();
      renderChips();
    }
  }

  function afterMultiStateChange() {
    resetPromotionToolsIfBaseInvalid();
    updateBaseDividerState();
    refreshPrereqNoticeIfVisible();
  }

  function applyQtySelection(options) {
    var keepOpen = !!(options && options.keepOpen);
    var key = qtyPickerState.key;
    var label = qtyPickerState.label;
    var btn = qtyPickerState.btn;
    if (!key || !btn) {
      closeQtyPicker();
      return;
    }

    var shouldCancelPbn = false;
    if (key === "pbn") {
      var wasFootprints = !!state.qtyMeta.pbnFootprints;
      state.qtyMeta.pbnFootprints = !!qtyPickerState.tempSpecial;
      if (!state.qtyMeta.pbnFootprints) state.qty.pbn = qtyPickerState.tempValue;
      shouldCancelPbn = wasFootprints && !state.qtyMeta.pbnFootprints && qtyPickerState.tempValue < 3;
    } else {
      state.qty[key] = qtyPickerState.tempValue;
    }

    if (key === "pbn" && shouldCancelPbn && btn.classList.contains("is-active")) {
      toggleMulti(key, label, btn);
      afterMultiStateChange();
      setActiveWheelSelection(0, false);
      if (keepOpen) {
        requestAnimationFrame(function () {
          placeQtyPicker(btn);
        });
        return;
      }
      closeQtyPicker();
      return;
    }

    if (!btn.classList.contains("is-active")) {
      toggleMulti(key, label, btn);
    } else {
      if (key === "pbn") btn.classList.toggle("is-footprints", state.qtyMeta.pbnFootprints);
      invalidateAppliedResponse();
      renderChips();
    }

    afterMultiStateChange();
    if (keepOpen) {
      requestAnimationFrame(function () {
        placeQtyPicker(btn);
      });
      return;
    }
    closeQtyPicker();
  }

  if (qtyPicker && qtyWheel && qtyPop) {
    qtyWheel.addEventListener("click", function (event) {
      var target = event.target.closest(".sb-qty-item");
      if (!target) return;
      var btn = qtyPickerState.btn;
      var key = qtyPickerState.key;
      var label = qtyPickerState.label;
      var special = target.getAttribute("data-special");
      if (special === "pbn_footprints") {
        if (!canUsePbnFootprints(qtyPickerState.tempValue)) return;
        if (qtyPickerState.tempSpecial && btn && btn.classList.contains("is-active")) {
          toggleMulti(key, label, btn);
          afterMultiStateChange();
          setActiveWheelSelection(0, false);
          requestAnimationFrame(function () {
            placeQtyPicker(btn);
          });
          return;
        }
        var specialOn = !qtyPickerState.tempSpecial;
        setActiveWheelSelection(quantityValue("pbn"), specialOn);
        applyQtySelection({ keepOpen: true });
        return;
      }
      var value = Number(target.getAttribute("data-value"));
      if (!Number.isFinite(value)) return;
      var persistedValue = quantityValue(key);
      var isSameActiveValue =
        !qtyPickerState.tempSpecial &&
        persistedValue === value &&
        btn &&
        btn.classList.contains("is-active");
      if (isSameActiveValue) {
        setActiveWheelSelection(value, false);
        applyQtySelection({ keepOpen: true });
        return;
      }
      setActiveWheelSelection(value, false);
      applyQtySelection({ keepOpen: true });
    });

    var wheelTick = null;
    qtyWheel.addEventListener("scroll", function () {
      if (wheelTick) window.cancelAnimationFrame(wheelTick);
      wheelTick = window.requestAnimationFrame(function () {
        wheelTick = null;
        setActiveWheelSelection(closestWheelValue(), false);
      });
    });

    qtyPicker.addEventListener("click", function (event) {
      if (!event.target.classList.contains("sb-qty-backdrop")) return;

      var clickX = event.clientX;
      var clickY = event.clientY;
      var passthroughTarget = null;

      qtyPicker.style.pointerEvents = "none";
      var underlayEl = document.elementFromPoint(clickX, clickY);
      qtyPicker.style.pointerEvents = "";

      if (underlayEl) {
        passthroughTarget =
          underlayEl.closest(".sb-btn") ||
          underlayEl.closest("#sbApply") ||
          underlayEl.closest(".sb-parent-btn");
      }

      if (passthroughTarget) {
        closeQtyPicker();
        passthroughTarget.click();
        return;
      }

      closeQtyPicker();
    });

    window.addEventListener("resize", function () {
      if (!qtyPicker.classList.contains("is-open")) return;
      placeQtyPicker(qtyPickerState.btn);
    });

    window.addEventListener("scroll", function () {
      if (!qtyPicker.classList.contains("is-open")) return;
      placeQtyPicker(qtyPickerState.btn);
    }, true);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      var type = btn.getAttribute("data-type");
      var label = btn.textContent.trim();
      var key = btn.getAttribute("data-key");

      if (type === "single") {
        var group = btn.getAttribute("data-group");
        if (btn.classList.contains("is-active")) {
          btn.classList.remove("is-active");
          state.single[group] = "";
          state.singleKey[group] = "";
          invalidateAppliedResponse();
          renderChips();
          resetPromotionToolsIfBaseInvalid();
          updateBaseDividerState();
          refreshPrereqNoticeIfVisible();
          return;
        }
        setSingle(group, key, label, btn);
        resetPromotionToolsIfBaseInvalid();
        updateBaseDividerState();
        refreshPrereqNoticeIfVisible();
        return;
      }

      if (type === "multi") {
        if (isQuantityKey(key)) {
          if (!isBaseRequirementKey(key) && !hasRequiredBaseSelection()) {
            showPrereqNotice();
            return;
          }
          if (
            btn.classList.contains("is-active") &&
            !(qtyPicker && qtyPicker.classList.contains("is-open") && qtyPickerState.key === key)
          ) {
            toggleMulti(key, label, btn);
            afterMultiStateChange();
            if (qtyPicker && qtyPicker.classList.contains("is-open")) closeQtyPicker();
            return;
          }
          if (qtyPicker && qtyPicker.classList.contains("is-open") && qtyPickerState.key === key) {
            if (btn.classList.contains("is-active")) {
              toggleMulti(key, label, btn);
              afterMultiStateChange();
            }
            closeQtyPicker();
            return;
          }
          openQtyPicker(key, label, btn);
          return;
        }

        if (btn.classList.contains("is-active")) {
          toggleMulti(key, label, btn);
          afterMultiStateChange();
          return;
        }

        if (!isBaseRequirementKey(key) && !hasRequiredBaseSelection()) {
          showPrereqNotice();
          return;
        }
        toggleMulti(key, label, btn);
        afterMultiStateChange();
        return;
      }

      if (type === "parent") {
        var parentKey = key;
        setParentOpen(parentKey, !state.open[parentKey], btn);
        refreshPrereqNoticeIfVisible();
        return;
      }

      if (type === "sub") {
        if (!hasRequiredBaseSelection()) {
          showPrereqNotice();
          return;
        }
        var p = btn.getAttribute("data-parent");
        ensureParentActive(p);

        var on = btn.classList.toggle("is-active");
        if (on) {
          addToken(label);
          flyWord(label, btn);
        } else {
          removeToken(label);
        }
        invalidateAppliedResponse();
        renderChips();
        updateBaseDividerState();
        refreshPrereqNoticeIfVisible();
      }
    });
  });

